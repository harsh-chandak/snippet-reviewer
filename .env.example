# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env
#
# Pick ONE of the two model modes below: leave its lines uncommented and the other mode's
# lines commented out.

# Used when running the API outside Docker. docker-compose sets its own.
DATABASE_URL=postgres://snippets:snippets@localhost:5433/snippets
PORT=4000
WEB_ORIGIN=http://localhost:3000

# ── Mode A: Claude Code login (`claude -p`), no API key ────────────────────────────────────
# Runs the local Claude Code CLI on your own Claude login. Needs `claude` installed and signed
# in on this machine, so the API must run on your machine (npm run dev), not inside Docker.
LLM_PROVIDER=claude-headless
# A Claude Code CLI model alias.
LLM_MODEL=sonnet
# Uncomment if `claude` isn't on your PATH:
# CLAUDE_BIN=/path/to/claude

# ── Mode B: Anthropic API key ──────────────────────────────────────────────────────────────
# Calls the Messages API directly. Works with `docker compose up --build`, or npm run dev.
# To use it: comment out the two Mode A lines above, uncomment these three, paste your key.
# LLM_PROVIDER=anthropic
# A full model id, not an alias.
# LLM_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Both modes ─────────────────────────────────────────────────────────────────────────────
# How long one model call may take before the review fails with a timeout.
LLM_TIMEOUT_MS=120000

# Mode B only, optional: dollars per million tokens, used only when all four are set (a
# negotiated rate, or a model the built-in list doesn't have). Left empty, each review is priced
# at the model's list price (api/src/service/llm/prices.ts); a model not on that list shows
# "cost not configured". No price is ever guessed. Mode A shows the CLI's own cost estimate.
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
LLM_PRICE_CACHE_READ_PER_MTOK=
LLM_PRICE_CACHE_WRITE_PER_MTOK=

# Tests only: LLM_PROVIDER=fake answers from a queue the test fills, and never calls a model.
