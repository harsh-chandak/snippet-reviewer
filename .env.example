# Copy to .env and fill in. Never commit .env.

# Used when running the API outside Docker. docker-compose sets its own.
DATABASE_URL=postgres://snippets:snippets@localhost:5433/snippets
PORT=4000
WEB_ORIGIN=http://localhost:3000

# LLM
# claude-headless runs the local Claude Code CLI (`claude -p`) on your own login.
# It works when the API runs on your machine (npm run dev), not inside Docker.
# anthropic calls the Messages API with ANTHROPIC_API_KEY. fake is for tests only.
LLM_PROVIDER=claude-headless
# claude-headless takes a CLI alias (sonnet); anthropic needs a full model id (claude-sonnet-5-5).
LLM_MODEL=sonnet
LLM_TIMEOUT_MS=120000
# CLAUDE_BIN=claude
ANTHROPIC_API_KEY=
# Optional: dollars per million tokens, to show a cost for each review on the API provider.
# Leave empty and the page shows tokens with "cost not configured"; no price is ever guessed.
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
LLM_PRICE_CACHE_READ_PER_MTOK=
LLM_PRICE_CACHE_WRITE_PER_MTOK=
