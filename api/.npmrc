# Install scripts are skipped. Three dependencies have one: tree-sitter-python (it would compile a
# native module we never load; we use its prebuilt .wasm grammar), esbuild (used by vitest; its
# platform binary comes in as an optional dependency anyway) and fsevents (macOS only). Skipping
# them keeps npm ci working in the Alpine image, which has no Python or compiler.
ignore-scripts=true
